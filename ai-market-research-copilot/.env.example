# ── LLM Configuration ─────────────────────────────────────────────────────────
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA NIM — get key at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_RERANKER_MODEL=nvidia/nv-rerankqa-mistral-4b-v3

# LLM provider: "nvidia" | "gemini" | "ollama"
LLM_PROVIDER=nvidia

# Embedding provider: "nvidia" | "local"
EMBEDDING_PROVIDER=nvidia

# RAG: fetch this many candidates from FAISS before reranking
RERANKER_FETCH_K=20

# Ollama settings (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ── App Settings ───────────────────────────────────────────────────────────────
DEBUG=false
APP_NAME=AI Market Research Copilot
APP_VERSION=1.0.0

# ── Embedding Model ────────────────────────────────────────────────────────────
# Free local model from sentence-transformers (downloaded automatically)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ── FAISS ─────────────────────────────────────────────────────────────────────
TOP_K_RESULTS=6

# ── File Upload Limits ────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
