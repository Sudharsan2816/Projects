# LLM provider: "nvidia", "gemini", or "ollama"
LLM_PROVIDER=nvidia
LLM_REQUEST_TIMEOUT_SECONDS=90
REPORT_WORKER_COUNT=2
REPORT_MAX_ACTIVE_JOBS=10

# NVIDIA NIM configuration
# Get a key from https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_RERANKER_MODEL=nvidia/nv-rerankqa-mistral-4b-v3

# Gemini fallback
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# Ollama local fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Embedding provider: "nvidia" or "local"
EMBEDDING_PROVIDER=nvidia
EMBEDDING_MODEL=all-MiniLM-L6-v2
MODEL_CACHE_DIR=./data/model_cache

# Retrieval settings
TOP_K_RESULTS=6
RERANKER_FETCH_K=20
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# App settings
DEBUG=false
APP_NAME=AI Market Research Copilot
APP_VERSION=1.0.0
CORS_ALLOWED_ORIGINS=http://localhost:8000
CORS_ALLOW_CREDENTIALS=false
API_AUTH_TOKEN=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXEMPT_PATHS=/health
OBSERVABILITY_ENABLED=true
# Set these for the selected provider/model to enable estimated cost telemetry.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
MAX_FILE_SIZE_MB=50
LLM_MAX_OUTPUT_TOKENS=4096
CHAT_HISTORY_DB_LIMIT=20
CHAT_HISTORY_CONTEXT_LIMIT=6
