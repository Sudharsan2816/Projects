# ── LLM Configuration ─────────────────────────────────────────────────────────
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM provider: "gemini" (recommended, free) or "ollama" (local, fully offline)
LLM_PROVIDER=gemini

# Ollama settings (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ── App Settings ───────────────────────────────────────────────────────────────
DEBUG=false
APP_NAME=AI Market Research Copilot
APP_VERSION=1.0.0

# ── Embedding Model ────────────────────────────────────────────────────────────
# Free local model from sentence-transformers (downloaded automatically)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ── FAISS ─────────────────────────────────────────────────────────────────────
TOP_K_RESULTS=6

# ── File Upload Limits ────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
